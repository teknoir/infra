# Reference site file of the teknoir-local environment (the airgapped on-prem
# node). The live node at 192.168.5.181 was decommissioned on 2026-10-11; since
# then teknoir-local installs are verified only in the VM rig on the dev host
# (airgap/test/vm/, site/vmtest.env), and this file stays the reference for a
# customer install.
#
# Site configuration for the teknoir-local environment (the airgapped on-prem
# node). Public and committed: it holds no secrets. The build copies it into
# the bundle (site/ and node/site/); the LAN entrypoint (bash 3.2) and
# teknoir-node read it at run time. Plain KEY=value lines only: no variable
# expansion, command substitution or arrays (make-bundle.sh refuses them).

TEKNOIR_ENV=teknoir-local
TEKNOIR_DOMAIN=teknoir.airgapped

# The node's fixed address (static, or a DHCP reservation on the router).
# Every TEKNOIR_HOSTNAMES entry (plus the apex domain) resolves to it in the
# node's /etc/hosts block and on the LAN hosts (`teknoir-airgap trust`); in
# CoreDNS (coredns-custom) every <name>.<domain> does, teamspace names too.
NODE_IP=192.168.5.181
# ssh target (user@host) for `teknoir-airgap up`; the user needs sudo.
NODE=teknoir@192.168.5.181

# Short names below TEKNOIR_DOMAIN (space separated); the apex is always added.
TEKNOIR_HOSTNAMES="harbor argocd auth keycloak grafana"

# NODE_IP_DHCP_RESERVED (optional, yes|no): yes once NODE_IP is a fixed DHCP
# reservation on the router; `doctor` then accepts a 'dynamic' address. On
# teknoir-local NODE_IP is a lease of the UniFi gateway (MAC 58:47:ca:7d:39:f0):
# set yes after its Fixed IP is in place and survived a renewal (docs/airgap/
# HOST-SETUP.md, "Fixed address"). Confirmed 2026-10-09: Fixed IP set in UniFi,
# the ~17:00Z renewal kept 192.168.5.181.
NODE_IP_DHCP_RESERVED=yes

# Optional NTP servers for chrony on the node (space-separated IPv4 addresses
# or host names). Empty (teknoir-local, no NTP on the LAN): chrony serves its
# own clock, a local stratum-10 reference that every `up` corrects with the
# LAN host's time. Either way the node serves NTP to the LAN: point Robots and
# cameras at NODE_IP.
TIME_SOURCE=""

# BACKUP_AGE_RECIPIENTS (optional, space-separated age public keys age1...):
# node backups are also written encrypted to these keys. Public keys only;
# the private keys never go into a repository or onto the node.

# UPSTREAM_DNS (optional, space-separated IPv4): the LAN resolvers CoreDNS
# forwards unknown names to. Unset: the node's own non-loopback resolvers; with
# none (a full air gap) the node's systemd-resolved is exposed on NODE_IP and
# answers at once (its /etc/hosts names; NXDOMAIN for the rest).
K3S_DATA_DIR=/opt/k3s
