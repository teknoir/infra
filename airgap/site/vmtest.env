# vmtest.env — site config for the airgapped KVM test VM on the dev host (DESIGN D13, I-16).
#
# Same env and domain as teknoir-local, so a teknoir-local bundle runs
# unchanged. The VM sits on the isolated bridge tkvm0 (10.77.0.0/24, no NAT,
# FORWARD DROP), and the LAN host is the network namespace tklan
# (airgap/test/vm/lan-netns.sh), whose own /etc/hosts maps the names below to
# NODE_IP. The host's /etc/hosts is never used (the dev host is itself called
# teknoir.airgapped); the former live node (192.168.5.181) was decommissioned
# on 2026-10-11 and is never used.
#
# Shell-sourceable (bash 3.2), public, no secrets.
TEKNOIR_ENV=teknoir-local
TEKNOIR_DOMAIN=teknoir.airgapped
NODE_IP=10.77.0.10
NODE=teknoir@10.77.0.10
# Short names under TEKNOIR_DOMAIN; the apex domain is always added.
TEKNOIR_HOSTNAMES="harbor argocd auth keycloak grafana"
# TIME_SOURCE is unset: chrony on the node serves its own clock (local
# stratum 10, corrected by every up from the LAN host) to the LAN.
# UPSTREAM_DNS (optional, space-separated IPv4): the LAN resolvers CoreDNS
# forwards unknown names to. Unset: the node's own non-loopback resolvers; with
# none (a full air gap) the node's systemd-resolved is exposed on NODE_IP and
# answers at once (its /etc/hosts names; NXDOMAIN for the rest).
K3S_DATA_DIR=/opt/k3s
# BACKUP_AGE_RECIPIENTS: every node backup is also written age-encrypted to
# these TEST recipients (public keys). Their identities live only on the dev host, in
# ~/vmtest/age/vmtest.key and vmtest-recovery.key (`airgap/test/vm/vm.sh
# age-key` makes and checks them), never in the repo or on the VM; e2e.sh E13
# decrypts the LAN backup with each.
BACKUP_AGE_RECIPIENTS="age13jslpc7y8dzs8cexjeyhdr30kt8s3ymkxtwaj7ssr4m4hwuxtyqsnr70tx age1eu4rp2tdp0qzmwvlkmypc5prs6zqr7wx4yhl6m3vdd7eane0papsjngv0z"
