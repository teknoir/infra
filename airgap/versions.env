# shellcheck shell=bash
# Central version/configuration pinning for the teknoir-local air-gap bundle.
# Sourced by airgap/lib.sh AFTER REPO_ROOT is set; every value can be
# overridden from the environment.

# --- Bundle -----------------------------------------------------------------
BUNDLE_VERSION="${BUNDLE_VERSION:-0.1.0}"

# --- Target environment ------------------------------------------------------
TEKNOIR_DOMAIN="${TEKNOIR_DOMAIN:-teknoir.airgapped}"
TEKNOIR_HOST="${TEKNOIR_HOST:-teknoir@teknoir.airgapped}"
HARBOR_HOST="${HARBOR_HOST:-harbor.${TEKNOIR_DOMAIN}}"
HARBOR_URL="${HARBOR_URL:-https://${HARBOR_HOST}}"

# Static IP of the K3s node. Used as the default node IP by bootstrap-airgap.sh
# and render-bootstrap.sh for the node /etc/hosts block and coredns-custom.yaml
# (the __NODE_IP__ substitution). Every TEKNOIR_HOSTNAME resolves here in the
# air gap (no LAN DNS). Override in the environment or with --node-ip. To
# restore SSH auto-detection, clear this default (set the fallback to empty).
NODE_IP="${NODE_IP:-192.168.5.181}"

# K3s data dir on the node. scripts/deploy-argo.sh writes to
# /opt/k3s/server/manifests, i.e. the cluster runs with --data-dir /opt/k3s.
K3S_DATA_DIR="${K3S_DATA_DIR:-/opt/k3s}"

# --- Repositories -------------------------------------------------------------
GITOPS_REPO_DIR="${GITOPS_REPO_DIR:-${REPO_ROOT}/../platform-applications-gitops}"

# --- Charts (name version) ----------------------------------------------------
# GitOps charts shipped to Harbor project `teknoir` (backstage excluded: deleted
# on the teknoir-local branch).
GITOPS_CHARTS=(
  "app-of-apps 0.0.1"
  "auth 0.0.3"
  "cert-manager 0.0.1"
  "harbor 0.0.5"
  "istio 0.0.1"
  "monitoring 0.0.3"
  "device-controller 0.0.82"
  "devstudio-controller 0.0.82"
  "notebook-controller 0.0.82"
  "profile-controller 0.0.82"
  "user-controller 0.0.82"
)

# Infra charts (bootstrap tier, rendered statically but also bundled).
INFRA_CHARTS=(
  "argo 0.0.1"
)

# Charts whose images belong to the bootstrap tier (shipped additionally as
# containerd-importable tarballs): istio, argo (ArgoCD), harbor.
BOOTSTRAP_CHARTS=(istio argo harbor)

# --- Pinned upstream versions --------------------------------------------------
ISTIO_VERSION="${ISTIO_VERSION:-1.29.2}"
ISTIO_PILOT_IMAGE="docker.io/istio/pilot:${ISTIO_VERSION}"
ISTIO_PROXYV2_IMAGE="docker.io/istio/proxyv2:${ISTIO_VERSION}"

ARGOCD_HELM_VERSION="${ARGOCD_HELM_VERSION:-10.4.0}"   # argo-cd dep of infra charts/argo
ARGOCD_IMAGE_VERSION="${ARGOCD_IMAGE_VERSION:-v3.5.1}" # appVersion of argo-cd 10.4.0

HARBOR_HELM_VERSION="${HARBOR_HELM_VERSION:-1.18.3}"   # harbor dep of gitops charts/harbor

# K3s sandbox (pause) image, re-imported from the tarball dir on every k3s start.
PAUSE_IMAGE="${PAUSE_IMAGE:-docker.io/rancher/mirrored-pause:3.6}"

# K3s release used for the offline node install (docs/AIRGAP-HOST-SETUP.md).
# make-bundle.sh downloads the pinned binary + airgap-images tarball + install.sh
# into <bundle>/k3s/. Aligned with the KUBE_VERSION 1.33 helm-template default.
K3S_VERSION="${K3S_VERSION:-v1.33.5+k3s1}"
K3S_ARCH="${K3S_ARCH:-amd64}"

# --- Pinned tool versions (downloaded into bundle/tools/) ----------------------
CRANE_VERSION="${CRANE_VERSION:-v0.21.9}"
HELM_VERSION="${HELM_VERSION:-v4.2.4}"

# OS/arch pairs the tools are bundled for.
TOOL_PLATFORMS=(
  "linux amd64"
  "darwin arm64"
)

# --- Registry mirroring ---------------------------------------------------------
# Upstream registry -> Harbor project prefix (order matters for docs only).
MIRRORED_REGISTRIES=(
  "docker.io dockerhub"
  "ghcr.io ghcr"
  "gcr.io gcr"
  "quay.io quay"
  "registry.k8s.io k8s"
)

# Harbor project that stores Helm OCI charts.
HARBOR_CHART_PROJECT="${HARBOR_CHART_PROJECT:-teknoir}"

# Hostnames that must resolve to the node IP (node /etc/hosts + coredns-custom).
TEKNOIR_HOSTNAMES=(
  "harbor.${TEKNOIR_DOMAIN}"
  "argocd.${TEKNOIR_DOMAIN}"
  "auth.${TEKNOIR_DOMAIN}"
  "keycloak.${TEKNOIR_DOMAIN}"
  "grafana.${TEKNOIR_DOMAIN}"
  "${TEKNOIR_DOMAIN}"
)
