# shellcheck shell=bash
# shellcheck disable=SC2034  # every value here is read by airgap/build/*.sh
#
# Build pins for the airgap bundle. Only the connected build
# (airgap/build/*.sh, bash >= 4.4) sources this file. The node and the LAN host
# read what they need from the bundle itself: MANIFEST.yaml, node/bundle.env,
# node/charts/pins.txt and node/images/images.lock.
#
# Site settings (domain, node IP, ssh target, hostnames) are NOT here; they
# live in airgap/site/<env>.env.
#
# Test overrides: APP_OF_APPS_VERSION, ONESHOT_TIERS, EXTRA_CHART_PINS,
# IMAGE_PLATFORMS and PROFILE_PLUGIN_CHARTS may be overridden from the
# environment. An override makes the
# bundle irreproducible from the two commits, so make-bundle.sh then requires
# --allow-dirty and marks the bundle id "-dirty".

# --- Release -------------------------------------------------------------------
# The root app-of-apps chart version. Every other GitOps chart version is read
# from what this app-of-apps renders; infra never repeats those pins.
APP_OF_APPS_VERSION="0.0.4"

# app-of-apps versions that must never be built or deployed, not even as a
# rollback target: their Harbor contents were overwritten on 2026-09-14 (both
# pin harbor 0.0.8 = Harbor 2.15.2 with a one-way DB migration and unmirrored
# images, and auth 0.0.6/0.0.7). The build refuses them; the list is copied
# into MANIFEST.yaml and node/bundle.env for the node's release phase.
BROKEN_APP_OF_APPS_VERSIONS="0.0.1 0.0.2"

# Root Application identity. The bundle renders app-of-apps as ArgoCD renders
# the root Application (release name = Application name, namespace =
# destination namespace); node/templates/app-of-apps.yaml.tmpl must agree.
ROOT_APP_NAME="app-of-apps"
ROOT_APP_NAMESPACE="teknoir-system"

# Harbor project that holds the Helm OCI charts. Every Application app-of-apps
# renders must pull from oci://harbor.<domain>/<HARBOR_CHART_PROJECT>.
HARBOR_CHART_PROJECT="teknoir"

# --- One-shot tiers (node/oneshot) ------------------------------------------------
# Applied by the node, in this order, while their ArgoCD Application does not
# exist yet. Each tier is the chart of the same name, rendered from its bundled
# .tgz with `helm template --include-crds` and zero value overrides.
ONESHOT_TIERS="platform-secrets istio harbor argo"

EXTRA_CHART_PINS=""

# --- Images ------------------------------------------------------------------------
# Platforms pulled for every image. Exactly one for now (the node arch); the
# code is list-shaped for a later arm64 node.
IMAGE_PLATFORMS="linux/amd64"

# Images the node imports into containerd before Harbor exists, in addition to
# everything the one-shot tiers render: the injected istio sidecar, the k3s
# sandbox image and the toolbox used by the bootstrap Jobs (D5).
BOOTSTRAP_EXTRA_IMAGES="
docker.io/istio/proxyv2:1.29.2
docker.io/rancher/mirrored-pause:3.6
docker.io/alpine/k8s:1.34.11
"

# Upper bound for the tar (bytes): catches multi-platform bloat (the old
# multi-arch bundle was 8.1 GB). Measured 2026-10-08: 3.3 GiB for app-of-apps
# 0.0.3 (44 images); app-of-apps 0.0.4 adds backstage, backstage-app and
# keycloak-config-cli (about 650 MiB compressed). r5 (app-of-apps 0.0.5) adds
# the teamspace plugin images (about 1.8 GiB compressed, 20 images), so a
# bundle is about 5.8 GiB: 6.5 GiB (decision D12 of the r5 plan). Over 4 GiB,
# FAT32 media need make-bundle.sh --split; use exFAT or ext4.
BUNDLE_MAX_BYTES=$((6656 * 1024 * 1024))

# Teknoir images must be pinned "<repo>:<immutable tag>@sha256:<linux/amd64
# manifest digest>" in every platform render (G-09; the rule is
# lib-build.sh teknoir_pin_ok). ALLOW_MUTABLE_TEKNOIR_TAGS=1 in the build's
# environment downgrades that to a warning and marks the bundle id
# "-mutable" (and MANIFEST.yaml mutableTeknoirTags: true); never roll such a
# bundle out to the live environment.

# --- Teamspace plugins (profile-plugins-helm) ------------------------------------------
# profile-controller creates one ArgoCD Application per plugin and teamspace
# (Profile) at run time, so app-of-apps never renders them. The bundle carries
# the published chart archives of the plugins the controller enables by
# default, and every image they render; the node pushes the charts to
# harbor.<domain>/teknoir like every other chart. The chart version and repo
# come from the profile-controller render (ConfigMap
# PROFILE_CONTROLLER_CONFIGMAP, keys PLUGIN_CHART_REPO and
# PLUGIN_CHART_VERSION, contract K2); the repo must be
# harbor.<domain>/<HARBOR_CHART_PROJECT>.
#
# Empty PROFILE_PLUGIN_CHARTS = a bundle without teamspace plugins (for a
# rollback build of an app-of-apps whose profile-controller has no
# PLUGIN_CHART_REPO; teamspaces then cannot work offline). Postgres and claims
# are disabled by default in the controller and NOT carried: airgap Profiles
# must not enable them.
PROFILE_PLUGIN_CHARTS="deadend emqx prometheus jwks fleet-metrics grafana mongodb historian observatory"
# Where the archives are published (chart-releaser: tgz in the GitHub
# releases, index.yaml on gh-pages). Each download must equal both its pin in
# PINNED_SHA256 ([profile-plugin-<name>-<version>]) and the index digest.
PROFILE_PLUGIN_SOURCE="https://teknoir.github.io/profile-plugins-helm"
PROFILE_CONTROLLER_APP="profile-controller"
PROFILE_CONTROLLER_CONFIGMAP="profile-controller-config"
# Namespace the plugin charts are rendered for (images and gates only): the
# first Profile in the profile-controller render, else this one.
TEAMSPACE_DEFAULT_NAMESPACE="teknoir-default"

# --- Node packages (.deb) ------------------------------------------------------------------
# Debian packages the node installs offline from node/debs (host phase):
# chrony (time service; the node has no NTP egress) and util-linux-extra
# (hwclock). Debian 13 (trixie) amd64, the node OS. "<package>=<version>".
# Pins: PINNED_SHA256[deb-<package>-<version>-<arch>] and
# PINNED_DEB_SHA1[same key] (the snapshot.debian.org fallback is keyed by
# sha1, for when the pool has dropped a superseded point-release file).
# Cross-checked on 2026-10-09 against the node's own signed apt metadata
# (`apt-cache show` on teknoir.airgapped) and the deb.debian.org downloads.
# Regenerate after a version bump with: airgap/build/fetch-tools.sh --print-pins
NODE_DEBS="chrony=4.6.1-3+deb13u2 util-linux-extra=2.41.5-0+deb13u1"
NODE_DEB_MIRROR="https://deb.debian.org"
NODE_DEB_SNAPSHOT="https://snapshot.debian.org/file"
# "<archive>:<suite>" indexes that --print-pins searches, in this order
NODE_DEB_SUITES="debian:trixie debian:trixie-updates debian-security:trixie-security"
# Pool directory of each package below NODE_DEB_MIRROR: the Filename of its
# entry in the first NODE_DEB_SUITES index that has the version (as
# --print-pins prints it). util-linux-extra 2.41.5-0+deb13u1 came as a
# trixie-security update and is also in the main pool since the point
# release; both serve the same file.
declare -gA NODE_DEB_POOL=(
  [chrony]=debian/pool/main/c/chrony
  [util-linux-extra]=debian/pool/main/u/util-linux
)
declare -gA PINNED_DEB_SHA1=(
  [deb-chrony-4.6.1-3+deb13u2-amd64]=1fc863918041705faa04c509d4659087b953cc69
  [deb-util-linux-extra-2.41.5-0+deb13u1-amd64]=74b818883fa5e3cc5967372e0f396c0b86911129
)

# Constant mtime for packaged charts (helm honours SOURCE_DATE_EPOCH), so the
# same chart source always packages to the same bytes and Harbor's
# digest-equality check holds across bundles. 1980-01-01T00:00:00Z.
CHART_SOURCE_DATE_EPOCH=315532800

# --- Node (k3s) ----------------------------------------------------------------------
K3S_VERSION="v1.33.5+k3s1"
NODE_OS="linux"
NODE_ARCH="amd64"

# --- Tools -----------------------------------------------------------------------------
# Node tools (node/bin, linux-amd64): helm crane jq age.
# Build-host tools (the build runs them from its own work dir): helm crane jq yq.
# LAN-host convenience kubectl (tools/<os>-<arch>/kubectl).
HELM_VERSION="v4.3.0"
CRANE_VERSION="v0.21.9"
JQ_VERSION="1.8.1"
AGE_VERSION="v1.3.1"
YQ_VERSION="v4.53.6"
KUBECTL_VERSION="v1.33.5"
LAN_KUBECTL_PLATFORMS="linux-amd64 darwin-arm64 darwin-amd64"

# sha256 of every downloaded upstream artifact, keyed "<tool>-<version>-<os>-<arch>"
# (k3s: "<version>-<asset>"). Each download must match BOTH this pin and the
# upstream checksum (helm .sha256sum, crane checksums.txt, jq sha256sum.txt,
# yq checksums-bsd, kubectl .sha256, k3s sha256sum-<arch>.txt, age: GitHub's
# release asset digest). k3s install.sh has none: pin only. Regenerate after a
# version bump with:
#   airgap/build/fetch-tools.sh --print-pins
# A changed version changes the key, so a bump can never reuse a stale pin or
# a stale cache entry.
declare -gA PINNED_SHA256=(
  [helm-v4.3.0-linux-amd64]=86584a54def73570558f66f5111cc53dfed56689637ae32c1201205d494f54fb
  [crane-v0.21.9-linux-amd64]=5c16d8ddb971cb1d5e6ed8b1e743da8224414eeba2c2762d8f1a61b2f095699e
  [jq-1.8.1-linux-amd64]=020468de7539ce70ef1bceaf7cde2e8c4f2ca6c3afb84642aabc5c97d9fc2a0d
  [age-v1.3.1-linux-amd64]=bdc69c09cbdd6cf8b1f333d372a1f58247b3a33146406333e30c0f26e8f51377
  [yq-v4.53.6-linux-amd64]=c5f056448f973ae7d39b5401949648a78f2dc1947d6a8eb65be60d5c504b9385
  [kubectl-v1.33.5-linux-amd64]=6a12d6c39e4a611a3687ee24d8c733961bb4bae1ae975f5204400c0a6930c6fc
  [kubectl-v1.33.5-darwin-arm64]=22f7256932c1c5205d7323a63d16253b8405ecccfd57c7a2484d3219c6822d3e
  [kubectl-v1.33.5-darwin-amd64]=ebdefb65c60c920510a605f13622e7eadb85bb83ba393d9eed2389bac30672b1
  [k3s-v1.33.5+k3s1-k3s]=ba2bc6892347d5ddf7d9a1f50b4d6fe73c6c325eb16894aa95993ac143096725
  [k3s-v1.33.5+k3s1-k3s-airgap-images-amd64.tar.zst]=c1d71ab864b6b7de087d0827a1810c5fd271134e317af8730ec9211eaf34b097
  # the release checksum file itself; equals GitHub's asset digest
  [k3s-v1.33.5+k3s1-sha256sum-amd64.txt]=4be2ec4331ecb9e365d9b3ff0ad12bf2bf382b6f366743b4adb1eb494998b919
  # no upstream checksum; its git blob equals the v1.33.5+k3s1 tag's install.sh (bb680b3)
  [k3s-v1.33.5+k3s1-install.sh]=9ca7930c31179d83bc13de20078fd8ad3e1ee00875b31f39a7e524ca4ef7d9de
  # NODE_DEBS: SHA256 of the Packages entries (trixie, trixie-security)
  [deb-chrony-4.6.1-3+deb13u2-amd64]=3b3fb6b13818c288ea0121038dc3220da869c6dc5d1e5c4d5f7b13647f3ff7e7
  [deb-util-linux-extra-2.41.5-0+deb13u1-amd64]=b5d0492ee97c7f3f79178973f2518af631669d5ad84ff7e539ec6bfe6f0bd700
  # PROFILE_PLUGIN_CHARTS at the version the profile-controller render pins:
  # the gh-pages index.yaml digests, verified equal to the published .tgz
  # files on 2026-10-09 (the same bytes staging r415 runs)
  [profile-plugin-deadend-0.0.99]=12834fe07fdc2fb8d1011ba34093877616d8abfe5768be0c2ab7d7e8bfb4618b
  [profile-plugin-emqx-0.0.99]=99c426fcfc01676dbe0d4f0ddf6b4e0087788a8bae210dfed9b1f7886c536483
  [profile-plugin-prometheus-0.0.99]=52e659dd4fcdd4ac6d6e89df6336079f81cb92412d62e5a19642d90d4b22a79a
  [profile-plugin-jwks-0.0.99]=fce9f8468cd58451142a657f53634cda578bc1e1f57e6009d05329eb3e54e65c
  [profile-plugin-fleet-metrics-0.0.99]=1d29cb50b6c8a2660e68bbe3c9a2b25c2d88b730350ce4781b10650e4f2c2876
  [profile-plugin-grafana-0.0.99]=1ce0117b514d06f5705c1dab7c869ce3384afc98cceef468f97944f37604e267
  [profile-plugin-mongodb-0.0.99]=98d5989aa3b95546f68fbca0c5e49b2b9ffbe902e767270745daac0209a7f1e2
  [profile-plugin-historian-0.0.99]=0f0eaf727b1565439451ceb2f735c146de4304200fd16f02bbbc3a36bb1d3df6
  [profile-plugin-observatory-0.0.99]=200a6ec69d9cae09b47df6ec1badf899544369cce56889c8e5c503fca247e899
)
